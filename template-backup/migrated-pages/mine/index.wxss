.mine-content{padding:36rpx 32rpx calc(248rpx + env(safe-area-inset-bottom))}.mine-header{padding:16rpx 0;display:flex;align-items:center;gap:28rpx;margin-bottom:32rpx}.avatar{width:128rpx;height:128rpx;border-radius:50%;border:2rpx solid #6574ff4d;background:#f1f5ff;box-shadow:0 12rpx 28rpx #aa57ff1f;padding:16rpx;flex-shrink:0}.avatar image{width:96rpx;height:96rpx}.mine-header>text{font-size:36rpx;font-weight:800;color:#121a38}.menu-group{background:#ffffffef;border:2rpx solid #ffffffb3;border-radius:32rpx;box-shadow:0 8rpx 20rpx #3e66b118;overflow:hidden}.menu-row{display:flex;align-items:center;width:100%;min-width:0;padding:30rpx 32rpx;background:none;border:0;border-radius:0;color:#121a38;text-align:left;line-height:1.4}.menu-icon{width:40rpx;height:40rpx;margin-right:24rpx;flex-shrink:0}.menu-row>text:not(.cache-size){font-size:30rpx;font-weight:500;flex:1}.chevron{width:40rpx;height:40rpx;flex-shrink:0}.menu-divider{height:2rpx;background:#6d7eb51f;margin-left:104rpx}.cache-group{margin-top:24rpx}.cache-size{font-size:26rpx;color:#9ca6c2;margin-right:8rpx}
