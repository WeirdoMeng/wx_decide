.tabs{position:fixed;bottom:calc(4rpx + env(safe-area-inset-bottom));left:36rpx;right:36rpx;z-index:20;display:flex;padding:14rpx;background:rgba(255,255,255,.74);border-radius:56rpx;border:2rpx solid rgba(255,255,255,.86);box-shadow:0 36rpx 72rpx #516db429}.tab{flex:1;margin:0 4rpx;border:2rpx solid transparent;border-radius:38rpx;padding:18rpx 0;display:flex;flex-direction:column;align-items:center;color:#7580a0;font-size:22rpx;font-weight:500;line-height:26rpx;gap:8rpx}.icon{width:46rpx;height:46rpx}.active{background:rgba(255,255,255,.88);border-color:rgba(255,255,255,.98);color:#6574ff;font-weight:600}
