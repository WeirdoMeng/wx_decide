/* Flutter lib/shared/theme and widgets; design size 375×812. Page artwork is an image node. */
page{background:#F4F8FF;color:#121A38;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif;font-size:28rpx}view,text,input,button,textarea{box-sizing:border-box}button{min-width:0;margin:0;font-size:28rpx;line-height:1.4}button::after{border:0}button[disabled]{opacity:.45}.original-screen{position:relative;min-height:100vh;overflow:hidden}.main-bg{position:fixed;top:0;left:0;width:100vw;height:100vh;z-index:0;pointer-events:none}.original-body{position:relative;z-index:1}.full-column{height:100vh;display:flex;flex-direction:column}.page{min-height:100vh;padding:28rpx 32rpx 56rpx}.tab-page{padding-bottom:calc(184rpx + env(safe-area-inset-bottom))}.title{font-size:44rpx;font-weight:800;line-height:1.25}.subtitle{font-size:26rpx;color:#9ca6c2;line-height:1.6}.muted{font-size:24rpx;color:#9ca6c2;line-height:1.6}.row{display:flex;align-items:center;justify-content:space-between}.card{background:rgba(255,255,255,.74);border:2rpx solid rgba(255,255,255,.7);border-radius:40rpx;box-shadow:0 8rpx 20rpx #3e66b118;padding:28rpx}.primary{display:flex;align-items:center;justify-content:center;min-height:104rpx;border-radius:52rpx;background:linear-gradient(90deg,#35b8ff,#5e7cff,#9d55f8);color:white;font-weight:600;font-size:32rpx;padding:20rpx 32rpx;box-shadow:0 12rpx 36rpx #aa57ff57}.secondary{display:flex;align-items:center;justify-content:center;min-height:104rpx;border-radius:52rpx;background:#f2f6ff;color:#121a38;font-weight:600;font-size:32rpx;padding:20rpx 32rpx;border:2rpx solid rgba(255,255,255,.88)}.field{height:94rpx;min-height:94rpx;border-radius:24rpx;border:2rpx solid white;padding:0 28rpx;background:rgba(255,255,255,.88);font-size:30rpx;font-weight:500;color:#121a38;box-shadow:0 16rpx 40rpx #6574ff1f,0 -4rpx 16rpx #fffffff2}.field-placeholder{font-size:30rpx;font-weight:400;color:#9ca6c2b3}.section-title{font-size:30rpx;font-weight:600}.label{font-size:26rpx;font-weight:600;color:#7580a0}.link{font-size:28rpx;color:#6574ff}.divider{height:1rpx;background:#6d7eb51f}.button-row{display:flex;gap:24rpx}.button-row button{flex:1}.pill{padding:10rpx 24rpx;background:#6574ff1f;color:#6574ff;border-radius:30rpx}.empty{text-align:center;color:#9ca6c2;font-size:28rpx;line-height:1.8;padding:70rpx 20rpx}.tap-icon{display:flex;align-items:center;justify-content:center;background:transparent;border:0;padding:0}.tap-icon image{width:40rpx;height:40rpx}.original-body>.primary{margin:0 40rpx}
