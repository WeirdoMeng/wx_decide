<view class="original-screen timing-screen">
 <image class="main-bg" src="/assets/original/main_bg.jpg" mode="aspectFill"/>
 <view class="original-body">
  <original-nav title="十秒挑战" managed-back="{{true}}" bind:back="goBack"/>
  <view class="timing-content phase-{{phase}} {{multi ? 'is-multi' : ''}}">
   <block wx:if="{{phase === 'setup'}}">
    <view class="hero"><view class="eyebrow">凭感觉，把时间按住</view><view class="clock-art"><view class="clock-top"></view><view class="clock-face"><text>10</text><view class="clock-hand"></view></view></view><view class="hero-title">你的十秒，有多准？</view><view class="muted">数字消失后，靠直觉找到那个瞬间</view></view>
    <view class="card settings-card"><view class="setting-label">挑战目标</view><view class="chips"><button wx:for="{{targets}}" wx:key="*this" class="chip {{!customTarget && target === item ? 'selected' : ''}}" data-field="target" data-value="{{item}}" bindtap="choose">{{item}} 秒</button><button class="chip custom-chip {{customTarget ? 'selected' : ''}}" bindtap="customDuration">{{customTarget ? target + ' 秒 ✎' : '自定义 ✎'}}</button></view><view class="setting-row"><view>多人对决<view class="minor">轮流挑战，误差越小排名越高</view></view><switch checked="{{multi}}" color="#6574ff" bindchange="toggleMulti"/></view><block wx:if="{{multi}}"><view class="setting-row"><text>玩家人数</text><view class="stepper"><button data-delta="-1" disabled="{{players <= 2}}" bindtap="playersChange">−</button><text>{{players}} 人</text><button data-delta="1" disabled="{{players >= 8}}" bindtap="playersChange">＋</button></view></view><view class="setting-row"><text>每人次数</text><view class="chips compact"><button wx:for="{{roundOptions}}" wx:key="*this" class="chip {{rounds === item ? 'selected' : ''}}" data-field="rounds" data-value="{{item}}" bindtap="choose">{{item}} 次</button></view></view></block><view wx:if="{{best}}" class="best-record">{{target}} 秒挑战 · 本机最佳误差 {{best}} 秒</view></view>
    <button class="primary main-action" bindtap="startMatch">{{multi ? '准备开始，轮流挑战' : '试试我的时间感'}} ›</button><button class="help-link" bindtap="showHelp">怎么玩？</button>
   </block>
   <block wx:elif="{{phase === 'ready' || phase === 'running'}}"><view class="turn-pill">{{turnLabel}}</view><view class="target-line">目标 <text>{{target}} 秒</text></view><view class="timer-card"><view class="digital-clock {{clockHidden ? 'clock-hidden' : ''}}"><view class="clock-cell"><text class="clock-digits">{{clockHidden ? '--' : clockMinutes}}</text><text class="clock-label">分</text></view><text class="clock-separator">:</text><view class="clock-cell"><text class="clock-digits">{{clockHidden ? '--' : clockSeconds}}</text><text class="clock-label">秒</text></view><text class="clock-separator">.</text><view class="clock-cell milliseconds"><text class="clock-digits">{{clockHidden ? '---' : clockMillis}}</text><text class="clock-label">毫秒</text></view></view><view class="timer-caption">{{phase === 'ready' ? '准备好后，点下方按钮开始' : clockHidden ? '读秒已隐藏，相信你的感觉' : '记住这个节奏，数字即将隐藏'}}</view></view><button class="primary timing-button {{phase === 'running' ? 'running' : ''}}" bindtap="press">{{phase === 'running' ? '就是现在，按停！' : '开始计时'}}</button><view class="play-note">{{phase === 'running' ? '计时中离开页面，本次挑战将作废' : hideHint + '，误差越小越好'}}</view></block>
   <view wx:elif="{{phase === 'invalid'}}" class="invalid-state"><view class="invalid-symbol">Ⅱ</view><view class="hero-title">这一秒，先不算</view><view class="muted"><view>计时已中断，本次没有计分</view><view>准备好后，可以重新挑战</view></view><button class="primary" bindtap="retry">重新挑战</button><button class="secondary" bindtap="settings">调整设置</button></view>
   <block wx:else>
    <view class="result-hero"><view class="eyebrow">{{turnLabel}} · 挑战完成</view><view class="hero-title">{{direction === '正中目标' ? '时间感，拿捏了！' : errorText <= 0.50 ? '就差那么一点点！' : '再靠近一点，就更准了'}}</view><view class="digital-clock result-clock"><view class="clock-cell"><text class="clock-digits">{{resultMinutes}}</text><text class="clock-label">分</text></view><text class="clock-separator">:</text><view class="clock-cell"><text class="clock-digits">{{resultSeconds}}</text><text class="clock-label">秒</text></view><text class="clock-separator">.</text><view class="clock-cell milliseconds"><text class="clock-digits">{{resultMillis}}</text><text class="clock-label">毫秒</text></view></view><view class="result-comparison">目标 {{target}} 秒 · 实际用时 {{elapsedText}} 秒</view><view class="error-pill">{{differenceText}}</view><view wx:if="{{isBest}}" class="best-label">刷新本机最佳误差</view></view>
    <view wx:if="{{multi}}" class="card result-details"><view class="detail-tabs"><button wx:if="{{ranking.length}}" class="{{detailTab === 'ranking' ? 'selected' : ''}}" data-tab="ranking" bindtap="detailTab">本场排名</button><button class="{{detailTab === 'attempts' ? 'selected' : ''}}" data-tab="attempts" bindtap="detailTab">挑战记录</button><text wx:if="{{detailTab === 'ranking'}}">{{rounds === 3 ? '按平均误差' : '按本次误差'}}</text></view><view class="detail-body"><view wx:for="{{detailRows}}" wx:key="key" class="detail-row"><text>{{item.title}}</text><view>{{item.value}}<text wx:if="{{item.extra}}" class="minor">{{item.extra}}</text></view></view></view><view class="pagination"><button disabled="{{detailPage === 0}}" data-delta="-1" bindtap="detailPage">‹ 上一页</button><text>{{detailPage + 1}} / {{detailPages}}</text><button disabled="{{detailPage + 1 >= detailPages}}" data-delta="1" bindtap="detailPage">下一页 ›</button></view></view>
    <button wx:if="{{!final}}" class="primary main-action" bindtap="next">传给下一位 ›</button><button wx:else class="primary main-action" disabled="{{adPending}}" loading="{{adPending}}" bindtap="again">再挑战一次</button><button class="secondary" disabled="{{adPending}}" bindtap="settings">调整设置</button>
   </block>
  </view>
 </view>
</view>
