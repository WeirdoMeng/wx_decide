.result-button,.intro-close{min-width:0}.result-button::after,.intro-close::after{border:0}
.result-overlay{position:fixed;inset:0;z-index:1200;display:flex;align-items:center;justify-content:center;background:rgba(0,0,0,.6)}.result-assembly{position:relative;width:590rpx;padding-top:56rpx;animation:appear .4s cubic-bezier(.2,.7,.3,1)}.result-card{position:relative;overflow:hidden;border-radius:48rpx;background:white;box-shadow:0 36rpx 72rpx #516db429}.result-bg{position:absolute;inset:0;width:100%;height:100%}.result-content{position:relative;padding:132rpx 48rpx 40rpx;display:flex;flex-direction:column;text-align:center}.result-icon{position:absolute;top:-26rpx;left:196rpx;width:198rpx;height:198rpx;animation:icon-enter .65s ease-out}.result-title{font-size:26rpx;color:#9ca6c2;letter-spacing:2rpx;margin-bottom:16rpx}.result-value{font-size:52rpx;line-height:1.25;font-weight:700;color:#121a38;word-break:break-all}.result-description{font-size:30rpx;color:#7580a0;line-height:1.55;margin-top:24rpx}.result-buttons{display:flex;gap:24rpx;margin-top:48rpx}.result-button{flex:1;border:0;border-radius:48rpx;height:96rpx;padding:0;display:flex;align-items:center;justify-content:center;font-size:32rpx;font-weight:600;line-height:1.3}.result-button::after{border:0}.done{color:#121a38;background:#f2f6ff}.again{color:white;background:linear-gradient(90deg,#35b8ff,#5e7cff,#9d55f8)}.intro-close{position:absolute;right:0;top:56rpx;background:rgba(255,255,255,.7);border:0;border-radius:50%;width:96rpx;min-width:96rpx;max-width:96rpx;flex:0 0 96rpx;height:96rpx;color:#7580a0;padding:0;font-size:56rpx;line-height:96rpx}.intro-close::after{border:0}@keyframes appear{0%{opacity:0;transform:scale(.92)}72%{opacity:1;transform:scale(1.03)}100%{transform:scale(1)}}@keyframes icon-enter{0%{opacity:0;transform:scale(.68) rotate(-8deg)}70%{opacity:1;transform:scale(1.12) rotate(5deg)}100%{transform:scale(1) rotate(0)}}

.result-button{width:0;min-width:0}

/* Keep source control sizes above native v2 button minimums. */
.result-buttons .result-button{min-width:0;flex:1 1 0%}.result-assembly .intro-close{min-width:96rpx;max-width:96rpx}
