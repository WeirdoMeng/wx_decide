<view wx:if="{{show}}" class="result-overlay" catchtouchmove="noop" bindtap="mask"><view class="result-assembly" catchtap="noop"><view class="result-card"><image class="result-bg" src="/assets/original/result_dialog_bg.png" mode="scaleToFill"/><view class="result-content"><text wx:if="{{!description}}" class="result-title">{{title}}</text><text class="result-value">{{result}}</text><text wx:if="{{description}}" class="result-description">{{description}}</text><view class="result-buttons"><button wx:if="{{!description}}" class="result-button done" bindtap="close">{{doneLabel}}</button><button class="result-button again" bindtap="again">{{againLabel}}</button></view></view></view><image class="result-icon" src="{{icon}}" mode="aspectFit"/><button wx:if="{{description}}" class="intro-close" bindtap="close" aria-label="关闭">×</button></view></view>
