<button class="art-button {{disabled || loading ? 'disabled' : ''}}" style="width:{{width}};height:calc({{width}} * {{ratio}})" bindtap="tap" aria-disabled="{{disabled || loading}}"><image class="button-artwork" src="{{source}}" mode="aspectFit"/><view wx:if="{{icon}}" class="button-icon"><image class="button-icon-image" src="{{icon}}" mode="aspectFit"/></view><text class="button-label">{{loading ? '请稍候…' : label}}</text></button>
