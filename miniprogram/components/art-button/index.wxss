.art-button{min-width:0}.art-button::after{border:0}
.art-button{position:relative;display:flex;align-items:center;justify-content:center;background:transparent;padding:0;line-height:1.4;margin:0 auto;overflow:visible;border:0;color:white;font-size:32rpx;font-weight:600}.art-button::after{border:0}.button-artwork{position:absolute;inset:0;width:100%;height:100%;pointer-events:none}.button-label{position:relative;z-index:1}.disabled{opacity:.45}
.button-icon{position:relative;z-index:1;width:60rpx;height:60rpx;flex:0 0 60rpx;border-radius:50%;background:#ffffff1a;margin-right:16rpx;display:flex;align-items:center;justify-content:center}.button-icon-image{position:static;width:36rpx;height:36rpx;flex:none}.button-label{white-space:nowrap;flex-shrink:0}.art-button{flex-shrink:0}

.art-button.art-button{min-width:0}
