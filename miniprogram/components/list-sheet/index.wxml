<view wx:if="{{show}}" class="sheet-mask" bindtap="close" catchtouchmove="noop"><view class="sheet" catchtap="noop"><view class="handle"></view><view class="sheet-heading"><text>{{templateOpen ? '选择模板' : '我的列表'}}</text><button wx:if="{{!templateOpen}}" class="new-list" bindtap="add"><image class="new-list-icon" src="/assets/original/add_rounded.png"/>新建</button></view><scroll-view class="sheet-list" scroll-y><block wx:if="{{!templateOpen}}"><view wx:for="{{lists}}" wx:key="id" class="list-row {{currentId === item.id ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="choose"><image wx:if="{{currentId === item.id}}" class="checked" src="/assets/original/check_circle_rounded.png"/><view class="list-copy"><view class="list-title">{{item.title}}</view><view class="list-count">{{item.count}} 个选项</view></view><button class="row-icon" data-id="{{item.id}}" catchtap="edit" aria-label="编辑"><image class="row-image" src="/assets/original/list_edit_icon.png"/></button><button class="row-icon {{lists.length <= 1 ? 'disabled' : ''}}" data-id="{{item.id}}" catchtap="remove" aria-label="删除"><image class="row-image" src="/assets/original/list_delete_icon.png"/></button></view></block><block wx:else><view wx:for="{{templates}}" wx:key="id" class="list-row template-row" data-id="{{item.id}}" bindtap="template"><view class="list-copy"><view class="list-title">{{item.title}}</view><view class="list-count preview">{{item.preview}}</view></view><image class="template-add" src="/assets/original/add_circle_outline_rounded.png"/></view></block></scroll-view><button wx:if="{{!templateOpen}}" class="template-action" bindtap="openTemplates"><image class="template-action-icon" src="/assets/original/dashboard_customize_outlined.png"/>从模板新建</button></view><view wx:if="{{confirmDelete}}" class="confirm-mask" catchtap="cancelDelete"><view class="confirm-card" catchtap="noop"><view class="confirm-title">删除列表</view><view class="confirm-message">确定删除「{{deleteTitle}}」？此操作不可撤销。</view><view class="confirm-buttons"><button class="confirm-button" bindtap="cancelDelete">取消</button><button class="confirm-button confirm-primary" bindtap="deleteConfirmed">删除</button></view></view></view></view>
