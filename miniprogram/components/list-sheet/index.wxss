.new-list,.row-icon,.template-action,.confirm-button{min-width:0}.new-list::after,.row-icon::after,.template-action::after,.confirm-button::after{border:0}
.sheet-mask{position:fixed;inset:0;z-index:1000;background:#0000008a;display:flex;align-items:flex-end}.sheet{width:100%;max-height:70vh;background:white;border-radius:48rpx 48rpx 0 0;border-top:2rpx solid #ffffffb3;box-shadow:0 36rpx 72rpx #516db429;padding:16rpx 0 calc(32rpx + env(safe-area-inset-bottom));display:flex;flex-direction:column;animation:slide-up .2s ease-out}.handle{width:80rpx;height:8rpx;border-radius:4rpx;background:#f2f4fa;margin:0 auto 24rpx}.sheet-heading{display:flex;align-items:center;justify-content:space-between;padding:0 24rpx 16rpx 40rpx;font-size:32rpx;font-weight:600;min-height:76rpx;color:#121a38}.new-list{padding:12rpx 20rpx;display:flex;align-items:center;gap:8rpx;border-radius:28rpx;border:2rpx solid #6574ff4d;background:#6574ff1f;color:#6574ff;font-size:28rpx;font-weight:600;margin:0}.new-list-icon{width:36rpx;height:36rpx}.sheet-list{max-height:calc(70vh - 200rpx - env(safe-area-inset-bottom));min-height:0}.list-row{display:flex;align-items:center;margin:0 32rpx 16rpx;padding:24rpx 20rpx 24rpx 28rpx;border-radius:32rpx;background:#f1f5ff;min-height:116rpx;border:3rpx solid transparent}.selected{border-color:#6574ff}.list-copy{flex:1;min-width:0}.list-title{font-size:30rpx;font-weight:500;color:#121a38;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.selected .list-title{color:#6574ff;font-weight:600}.list-count{font-size:24rpx;color:#9ca6c2;margin-top:4rpx}.checked{width:36rpx;height:36rpx;margin-right:16rpx}.row-icon{padding:0;border:0;background:none;width:68rpx;height:68rpx;display:flex;align-items:center;justify-content:center;margin:0}.row-image{width:48rpx;height:48rpx}.disabled{opacity:.28}.template-action{margin:24rpx auto 8rpx;padding:0;display:flex;align-items:center;justify-content:center;gap:12rpx;background:none;color:#7580a0;font-size:28rpx;font-weight:500}.template-action-icon{width:36rpx;height:36rpx}.template-row{padding-right:28rpx;border:2rpx solid #ffffffb3}.template-add{width:40rpx;height:40rpx;margin-left:20rpx}.preview{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.close-template{font-size:26rpx;color:#7580a0;background:none;padding:12rpx}.confirm-mask{position:fixed;inset:0;z-index:1001;background:#0000008a;display:flex;align-items:flex-end;padding:32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom))}.confirm-card{width:100%;background:#fff;border-radius:48rpx;padding:56rpx 48rpx}.confirm-title{text-align:center;font-size:40rpx;font-weight:700;color:#121a38}.confirm-message{text-align:center;font-size:26rpx;line-height:1.6;color:#9ca6c2;margin-top:32rpx}.confirm-buttons{display:flex;gap:24rpx;margin-top:48rpx}.confirm-button{flex:1;border-radius:48rpx;height:96rpx;display:flex;align-items:center;justify-content:center;background:#f2f6ff;color:#121a38;font-size:32rpx;font-weight:600}.confirm-buttons .confirm-primary{background:linear-gradient(90deg,#35b8ff,#5e7cff,#9d55f8);color:white}@keyframes slide-up{from{transform:translateY(100%)}to{transform:translateY(0)}}

.row-icon{flex:0 0 68rpx;min-width:0;max-width:68rpx}.new-list{flex:0 0 auto;min-width:0;width:auto}.confirm-button{width:0;min-width:0}
.new-list{width:144rpx;min-width:0;max-width:144rpx;flex:0 0 144rpx;white-space:nowrap}

/* Keep source control sizes above native v2 button minimums. */
.row-icon.row-icon{min-width:68rpx;max-width:68rpx}.new-list.new-list{min-width:144rpx;max-width:144rpx}.confirm-buttons .confirm-button{min-width:0;flex:1 1 0%}
