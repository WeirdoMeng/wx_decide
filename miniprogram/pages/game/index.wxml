<import src="./overlays.wxml"/>
<template name="player-stepper"><view class="source-player-row"><text>参与人数</text><view class="source-stepper"><button data-delta="-1" bindtap="changePlayers" disabled="{{players <= 2}}" aria-label="减少参与人数"><image src="/assets/original/party/remove_rounded.png"/></button><text>{{players}} 人</text><button data-delta="1" bindtap="changePlayers" disabled="{{players >= maxPlayers}}" aria-label="增加参与人数"><image src="/assets/original/party/add_rounded.png"/></button></view></view></template>
<template name="bomb-art"><view class="source-bomb-art {{burst ? 'bomb-burst' : ''}}" style="width:{{size*1.35}}rpx;height:{{size}}rpx;"><view class="bomb-shadow"></view><image src="/assets/original/party/party_intro_number_bomb.png" mode="aspectFit" style="width:{{size}}rpx;height:{{size}}rpx;"/></view></template>
<template name="bomb-range"><view class="source-range {{compact ? 'compact' : ''}}"><text>当前可猜范围</text><text class="range-main">{{availableMin}}—{{availableMax}}</text><view class="range-track"><view style="left:{{rangeLeft}}%;width:{{rangeWidth}}%;"/></view><view wx:if="{{!compact}}" class="range-labels"><text>1</text><text>{{maxNumber}}</text></view></view></template>
<template name="question-card"><view class="original-question-card"><text class="card-quote">“</text><view class="original-question-copy"><text style="width:{{530*questionScale}}rpx;font-size:{{44*questionScale}}rpx;line-height:{{72*questionScale}}rpx;">{{question}}</text></view><image class="original-card-art {{truth ? 'heart-art' : 'star-art'}}" src="/assets/original/party/{{truth ? 'truth_dare_heart' : 'truth_dare_star'}}.png" mode="scaleToFill"/></view></template>
<view class="game-source type-{{type}} phase-{{phase}} {{phase === 'biting' || phase === 'exploding' ? 'game-shaking' : ''}}" style="min-height:{{canvasHeight}}rpx;">
 <image wx:if="{{type === 'sharkTeeth'}}" class="game-background" src="{{art}}{{phase === 'playing' || phase === 'biting' ? 'shark_game_background' : 'shark_game_lobby_background'}}.jpg" mode="aspectFill"/>
 <image wx:elif="{{type === 'numberBomb'}}" class="game-background" src="{{art}}number_bomb_background.jpg" mode="aspectFill"/>
 <image wx:elif="{{type === 'truthDare'}}" class="game-background" src="{{art}}truth_dare_background.jpg" mode="aspectFill"/>
 <block wx:else><image class="game-background" src="{{art}}balloon_background_base.jpg" mode="aspectFill"/><image class="game-background" src="{{art}}balloon_background_overlay.jpg" mode="aspectFill"/></block>
 <original-nav title="{{title}}" help="{{true}}" managed-back="{{true}}" bind:back="requestBack" bind:help="help" bind:helplongpress="showSettings"/>
 <view class="source-canvas" style="top:{{topShift}}rpx;">
  <view wx:if="{{saveWarning}}" class="source-save-warning">{{saveWarning}}</view>

  <block wx:if="{{type === 'sharkTeeth'}}">
   <view wx:if="{{phase === 'setup'}}" class="shark-setup-body"><image class="source-shark-mascot" src="{{art}}shark_game_bite.png" mode="aspectFit"/><view class="source-glass-card shark-player-card"><template is="player-stepper" data="{{players,maxPlayers}}"/><view class="source-divider"></view><view class="source-tooth-count"><image src="{{art}}grid_view_rounded.png"/><text>本局启用 {{toothCount}} 颗牙齿</text></view></view><view class="source-art-action"><art-button label="开始游戏" icon="{{art}}play_arrow_rounded.png" source="{{art}}party_action_button.png" width="750rpx" ratio="{{258/1125}}" bind:action="start"/></view></view>
   <block wx:elif="{{phase === 'playing' || phase === 'biting'}}"><image class="shark-headline" src="{{art}}shark_game_headline.png" mode="scaleToFill"/><view class="shark-status source-glass"><image src="{{art}}shark_game_people.png"/><text>{{players}}人</text><image class="separator" src="{{art}}shark_game_separator.png"/><text class="remaining">{{phase === 'biting' ? '咬到了' : '剩余'+remaining+'颗'}}</text></view><view class="source-shark-stage"><view class="source-shark-shadow"></view><image class="shark-drop drop-r-small" src="{{art}}shark_game_drop_right_small.png"/><image class="shark-drop drop-r-large" src="{{art}}shark_game_drop_right_large.png"/><image class="shark-drop drop-l-small" src="{{art}}shark_game_drop_left_small.png"/><image class="shark-drop drop-l-large" src="{{art}}shark_game_drop_left_large.png"/><view class="source-shark-crop"><image src="{{art}}{{phase === 'biting' ? 'shark_game_bite' : 'shark_game_open'}}.png" mode="scaleToFill"/></view><view wx:if="{{phase === 'playing'}}" class="original-teeth"><view class="original-teeth-row" wx:for="{{teethRows}}" wx:key="id" wx:for-item="row"><button wx:for="{{row.teeth}}" wx:for-item="tooth" wx:key="index" class="original-tooth {{tooth.pressed ? 'pressed' : ''}}" disabled="{{locked || tooth.pressed}}" data-index="{{tooth.index}}" bindtap="pressTooth" aria-label="{{'第'+(tooth.index+1)+'颗牙'}}"><view>{{tooth.index+1}}</view></button></view></view></view><view class="shark-hint source-glass"><image src="{{art}}shark_game_tooth_outline.png"/><text>{{phase === 'biting' ? '咬到了' : remaining === 1 ? '下一位，按最后一颗' : remaining < toothCount ? '安全！传给下一位' : '按一颗亮牙，按完传手机'}}</text><image src="{{art}}shark_game_tooth_outline.png"/></view></block>
   <view wx:else class="shark-result-body"><image class="source-shark-mascot" src="{{art}}shark_game_bite.png" mode="aspectFit"/><text class="source-result-title">{{loser}} 号玩家中招了！</text><text class="source-subtitle">来个惩罚，或者直接再玩一局</text><view class="shark-result-actions"><button class="result-primary" bindtap="punishment">去接受惩罚</button><button class="source-secondary" bindtap="start">再玩一局</button><button class="source-secondary" bindtap="adjust">调整人数</button></view></view>
  </block>

  <block wx:elif="{{type === 'numberBomb'}}">
   <view wx:if="{{phase === 'setup'}}" class="bomb-setup-body"><template is="bomb-art" data="{{size:352}}"/><text class="source-heading">猜到就爆！</text><text class="source-subtitle">轮流报数，让炸弹范围越缩越小</text><view class="source-glass-card bomb-configuration"><template is="player-stepper" data="{{players,maxPlayers}}"/><view class="source-divider"></view><text class="source-setting-label">数字范围</text><view class="source-choices"><button wx:for="{{rangeOptions}}" wx:key="*this" class="{{maxNumber === item ? 'chosen' : ''}}" data-value="{{item}}" bindtap="chooseRange">1—{{item}}</button></view><text class="source-setting-label input-method-label">输入方式</text><view class="source-choices"><button class="{{!proxyMode ? 'chosen' : ''}}" data-value="pass" bindtap="chooseMode">传手机</button><button class="{{proxyMode ? 'chosen' : ''}}" data-value="proxy" bindtap="chooseMode">一人代输</button></view></view><view class="source-art-action"><art-button label="开始游戏" icon="{{art}}play_arrow_rounded.png" source="{{art}}party_action_button.png" width="750rpx" ratio="{{258/1125}}" bind:action="start"/></view></view>
   <block wx:elif="{{phase === 'input'}}"><scroll-view scroll-y class="bomb-input-body" style="top:{{contentTop+8}}px;height:calc(100vh - {{contentTop+8}}px - 174rpx - env(safe-area-inset-bottom));"><template is="bomb-art" data="{{size:176}}"/><text class="source-heading compact-heading">第{{attempts+1}}次猜数字</text><view class="bomb-input-range"><template is="bomb-range" data="{{availableMin,availableMax,maxNumber,rangeLeft,rangeWidth}}"/></view><view class="original-number-input {{input ? 'has-value' : ''}}">{{input || '点按下方数字'}}</view><text class="bomb-input-hint {{input && !canSubmit ? 'invalid' : ''}}">{{input && !canSubmit ? '请输入 '+availableMin+'—'+availableMax+' 之间的数字' : '当前可猜 '+availableMin+'—'+availableMax}}</text><view class="original-number-pad"><button wx:for="{{keypad}}" wx:key="*this" data-key="{{item}}" bindtap="keyPress" class="{{item === 'clear' || item === 'delete' ? 'secondary-key' : ''}}" aria-label="{{item === 'delete' ? '删除一位' : item === 'clear' ? '清空' : item}}"><image wx:if="{{item === 'delete'}}" src="{{art}}backspace_outlined.png"/><text wx:else>{{item === 'clear' ? '清空' : item}}</text></button></view></scroll-view><view class="bomb-confirm"><art-button label="确认猜测" disabled="{{!canSubmit}}" source="{{art}}party_action_button.png" width="750rpx" ratio="{{258/1125}}" bind:action="submitGuess"/></view></block>
   <view wx:elif="{{phase === 'handoff'}}" class="bomb-handoff-body"><template is="bomb-art" data="{{size:352}}"/><text class="source-heading">{{proxyMode ? lastGuess+' 安全！下一位报数' : lastGuess+' 安全，传给下一位'}}</text><text class="source-subtitle">{{lastHint || '可猜范围已经缩小'}}</text><view class="bomb-handoff-range"><template is="bomb-range" data="{{availableMin,availableMax,maxNumber,rangeLeft,rangeWidth,compact:true}}"/></view><view class="source-art-action"><art-button label="我准备好了" source="{{art}}party_action_button.png" width="750rpx" ratio="{{258/1125}}" bind:action="continueTurn"/></view></view>
   <view wx:elif="{{phase === 'lastReveal'}}" class="bomb-last-body"><template is="bomb-art" data="{{size:380}}"/><text class="source-heading">只剩最后一个数字</text><text class="source-subtitle">{{lastHint || '炸弹即将揭晓'}}</text><view class="source-glass-card last-number-card"><text>{{currentPlayer}} 号玩家亲手揭晓</text><text class="original-secret">{{availableMin}}</text><text>点击后公布炸弹数字</text></view><view class="source-art-action"><art-button label="揭晓数字" source="{{art}}party_action_button.png" width="750rpx" ratio="{{258/1125}}" bind:action="revealLast"/></view></view>
   <view wx:elif="{{phase === 'exploding'}}" class="original-explosion"><image src="{{art}}party_intro_number_bomb.png"/><canvas wx:if="{{!introShow && !exitOpen && !settingsOpen}}" type="2d" id="bomb-effects" class="bomb-explosion-canvas"/></view>
   <view wx:else class="bomb-result-body"><template is="bomb-art" data="{{size:300,burst:true}}"/><text class="source-heading">砰！{{loser}} 号玩家中招了</text><text class="source-subtitle">本轮挑战结束，来个小惩罚吧</text><view class="source-glass-card bomb-secret-card"><text>炸弹数字</text><text class="original-secret">{{secret}}</text><text class="bomb-attempts">本局猜了 {{attempts}} 次</text></view><view class="bomb-result-actions"><button class="result-primary" bindtap="punishment">去接受惩罚</button><button class="source-secondary" bindtap="start">再玩一局</button><button class="source-secondary" bindtap="adjust">调整设置</button></view></view>
  </block>

  <block wx:elif="{{type === 'truthDare'}}"><text class="question-measure">{{question}}</text>
   <view class="original-truth-tabs source-glass"><image class="truth-selected-tab" style="left:{{truth ? 2 : 300}}rpx;" src="{{art}}truth_dare_selected_tab.png"/><button class="{{truth ? 'tab-active' : ''}}" data-mode="truths" bindtap="switchTruth"><image src="{{art}}truth_dare_like{{truth ? '' : '_gray'}}.png"/><text>真心话</text></button><button class="{{!truth ? 'tab-active' : ''}}" data-mode="dares" bindtap="switchTruth"><image src="{{art}}truth_dare_dare{{!truth ? '_white' : ''}}.png"/><text>大冒险</text></button></view>
   <view class="original-card-deck" style="top:{{origin ? -52 : 0}}rpx;"><view class="rear-card-original rear-far"></view><image class="rear-card-original rear-near" src="{{art}}truth_dare_rear_card.png" mode="scaleToFill"/><view wx:if="{{flipping}}" class="advancing-card" style="animation-duration:{{flightDuration}}ms;--flight-duration:{{flightDuration}}ms;"><template is="question-card" data="{{question,truth,questionScale}}"/></view><view class="front-card-original {{flipping ? 'card-flying' : ''}} {{returning ? 'card-returning' : ''}}" style="transform:translateY({{dragY}}rpx);--flight-start:{{dragY}}rpx;animation-duration:{{flightDuration}}ms;" bindtouchstart="cardTouchStart" catchtouchmove="cardTouchMove" bindtouchend="cardTouchEnd" bindtouchcancel="cardTouchCancel"><template is="question-card" data="{{question:outgoingQuestion || question,truth,questionScale:outgoingQuestion ? outgoingScale : questionScale}}"/></view></view>
   <view class="original-swipe-hint" style="top:{{origin ? 1278 : 1350}}rpx;"><image src="{{art}}truth_dare_refresh.png"/><text>上滑换题</text></view><view class="original-next-card" style="top:{{origin ? 1320 : 1392}}rpx;"><art-button label="换一个" icon="{{art}}shuffle_rounded.png" disabled="{{flipping || returning}}" source="{{art}}party_action_button.png" width="750rpx" ratio="{{258/1125}}" bind:action="nextQuestion"/></view><button wx:if="{{origin}}" class="original-return-game" bindtap="finishPunishment">完成惩罚，返回重开</button>
  </block>

  <block wx:else>
   <image class="balloon-glow-original" src="{{art}}balloon_glow.png"/>
   <block wx:if="{{phase === 'playing' || phase === 'exploding'}}"><image class="original-balloon-play-title" src="{{art}}balloon_play_title.png" mode="scaleToFill"/><view class="original-balloon-playing" style="transform:scale({{phase === 'exploding' ? 1 : balloonScale}});"><image class="balloon-breath {{phase === 'exploding' ? 'balloon-burst' : ''}}" src="{{art}}balloon_play_character.png" mode="aspectFit"/><canvas wx:if="{{phase === 'exploding' && !introShow && !exitOpen && !settingsOpen}}" type="2d" id="balloon-effects" class="balloon-burst-canvas"/></view><view wx:if="{{phase === 'playing'}}" class="balloon-playing-hint source-glass">爆开时，持机者中招</view><button wx:if="{{phase === 'playing'}}" class="original-balloon-hold" bindtouchstart="beginHold" bindtouchend="cancelHold" bindtouchcancel="cancelHold" aria-label="长按0.8秒结束本局"><image src="{{art}}balloon_pause_button.png"/><image wx:if="{{holding}}" class="hold-track" src="{{art}}balloon_hold_ring.png"/><canvas wx:if="{{holding && !introShow && !exitOpen && !settingsOpen}}" type="2d" id="hold-effects" class="hold-effects-canvas"/></button><text wx:if="{{phase === 'playing'}}" class="balloon-hold-caption">长按结束本局</text></block>
   <block wx:else><image class="original-balloon-idle {{phase === 'ready' || phase === 'result' ? 'balloon-breath' : ''}}" src="{{art}}balloon_play_character.png" mode="aspectFit"/><block wx:if="{{phase === 'ready'}}"><text class="balloon-ready-title">传气球</text><view class="balloon-ready-settings source-glass"><text class="source-setting-label">爆炸节奏</text><view class="source-choices"><button wx:for="{{paceOptions}}" wx:key="*this" class="{{pace === index ? 'chosen' : ''}}" data-value="{{index}}" bindtap="choosePace">{{item}}</button></view><text>轮流传递手机，气球会在不确定的时间爆开</text></view><view class="balloon-ready-start"><art-button label="开始传气球" icon="{{art}}play_arrow_rounded.png" source="{{art}}party_action_button.png" width="750rpx" ratio="{{258/1125}}" bind:action="start"/></view></block><block wx:elif="{{phase === 'countdown'}}"><view class="original-countdown">{{countdown}}</view><text class="balloon-countdown-hint">拿稳手机，准备传递</text><button class="source-secondary balloon-cancel" bindtap="adjust">取消本局</button></block><block wx:else><text class="balloon-result-title">砰！气球爆了</text><view class="balloon-result-hint source-glass">现在拿着手机的人中招</view><view class="balloon-result-actions"><button class="result-primary" bindtap="punishment">去接受惩罚</button><button class="source-secondary" bindtap="start">再玩一局</button><button class="source-secondary" bindtap="adjust">返回调整</button></view></block></block>
  </block>
 </view>
</view>
<template is="party-settings" data="{{settingsOpen,settings}}"/>
<template is="party-exit" data="{{exitOpen,origin}}"/>
<result-dialog show="{{introShow}}" result="{{title}}" title="" description="{{introDescription}}" icon="{{introIcon}}" again-label="我知道了" done-label="" bind:again="closeIntro" bind:close="closeIntro"/>
