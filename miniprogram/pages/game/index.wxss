.advancing-card .card-quote,.advancing-card .original-question-copy,.advancing-card .original-card-art{animation:sourceCardContent var(--flight-duration,380ms) cubic-bezier(.645,.045,.355,1) both}@keyframes sourceCardContent{0%,72%{opacity:0}90%,100%{opacity:1}}

/* Keep source control sizes above native v2 button minimums. */
.game-source .header-glass{min-width:88rpx;max-width:88rpx}.source-simple-header>button{min-width:88rpx;max-width:88rpx}.source-stepper>button{flex:0 0 88rpx;min-width:88rpx;max-width:88rpx}.game-source .original-tooth{min-width:84rpx;max-width:84rpx}.source-choices button{flex:1 1 0%;width:0;min-width:0;white-space:nowrap}.original-number-pad{grid-template-columns:repeat(3,minmax(0,1fr))}.original-number-pad button{width:100%;min-width:0;max-width:100%}

/* Mini-program results: stretch within the content column, independent of native button width. */
.shark-result-actions .result-primary,.shark-result-actions .source-secondary,.bomb-result-actions .result-primary,.bomb-result-actions .source-secondary,.balloon-result-actions .result-primary,.balloon-result-actions .source-secondary{width:100%;min-width:0;max-width:100%;flex:none;padding:0 24rpx;box-sizing:border-box;text-align:center}
.shark-result-actions,.bomb-result-actions,.balloon-result-actions{align-items:stretch}
.source-save-warning{top:192rpx}

/* Result screens use document flow so short phones can scroll to every action. */
.type-numberBomb.phase-result,.type-sharkTeeth.phase-result,.type-passBalloon.phase-result{min-height:100vh!important;padding-bottom:calc(24rpx + env(safe-area-inset-bottom));box-sizing:border-box}
.phase-result .source-canvas{position:relative;top:0!important;height:auto;min-height:0}
.phase-result .bomb-result-body,.phase-result .shark-result-body{position:relative;top:auto;left:auto;right:auto;margin:16rpx 40rpx 0}
.bomb-result-body .bomb-secret-card{margin-top:32rpx}.bomb-result-body .bomb-result-actions{margin-top:32rpx}
.phase-result .original-balloon-idle{position:relative;left:auto;top:auto;width:440rpx;height:440rpx;display:block;margin:16rpx auto 0}
.phase-result .balloon-result-title{position:relative;left:auto;top:auto;width:auto;display:block;margin:20rpx 40rpx 0;font-size:52rpx}
.phase-result .balloon-result-hint{position:relative;left:auto;top:auto;width:auto;margin:20rpx 40rpx 0}
.phase-result .balloon-result-actions{position:relative;left:auto;top:auto;width:auto;margin:32rpx 40rpx 0}
@media(max-height:700px){
 .bomb-result-body .source-bomb-art{width:297rpx!important;height:220rpx!important}.bomb-result-body .source-bomb-art>image{width:220rpx!important;height:220rpx!important}
 .bomb-result-body .source-heading,.shark-result-body .source-result-title{font-size:44rpx;margin-top:16rpx}
 .bomb-result-body .bomb-secret-card{margin-top:24rpx;padding:24rpx}.bomb-result-body .original-secret{font-size:96rpx}
 .shark-result-body .source-shark-mascot{width:420rpx;height:280rpx}.shark-result-body .shark-result-actions{margin-top:32rpx}
 .phase-result .original-balloon-idle{width:360rpx;height:360rpx}
}

.type-numberBomb.phase-input{min-height:100vh!important;height:100vh;overflow:hidden}
.phase-input .bomb-input-body{position:fixed}
.phase-input .bomb-confirm{position:fixed;top:auto;bottom:env(safe-area-inset-bottom);z-index:4}
