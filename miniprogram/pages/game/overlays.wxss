.party-sheet-mask{position:fixed;left:0;right:0;top:0;bottom:0;z-index:1300;background:#23306280;display:flex;flex-direction:column;justify-content:flex-end}.party-settings-sheet{padding:20rpx 40rpx calc(48rpx + env(safe-area-inset-bottom));background:linear-gradient(135deg,#f8f5ff,#eaf6ff);border-radius:60rpx 60rpx 0 0;border:3rpx solid white}.party-sheet-handle{width:72rpx;height:8rpx;border-radius:8rpx;background:#6574ff38;margin:0 auto 44rpx}.party-sheet-title{display:block;text-align:center;font-size:42rpx;font-weight:800;line-height:1.4;color:#121a38}.party-sheet-subtitle{display:block;text-align:center;margin:12rpx 0 48rpx;font-size:26rpx;color:#7580a0}.party-setting-option{display:flex;align-items:center;min-height:156rpx;padding:24rpx 32rpx;background:#ffffffc7;border:2rpx solid white;border-radius:40rpx;margin-top:24rpx;box-shadow:0 8rpx 20rpx #6574ff0b}.party-setting-icon{width:88rpx;height:88rpx;border-radius:30rpx;background:#6574ff1f;display:flex;align-items:center;justify-content:center}.party-setting-icon image{width:46rpx;height:46rpx}.party-setting-copy{display:flex;flex:1;flex-direction:column;margin-left:26rpx;gap:6rpx}.party-setting-copy>text:first-child{font-size:32rpx;font-weight:700;color:#121a38}.party-setting-copy>text:last-child{font-size:24rpx;color:#7580a0}.party-switch{width:104rpx;height:60rpx;border-radius:36rpx;padding:6rpx;background:#dce5f4;transition:background .18s}.party-switch.on{background:linear-gradient(90deg,#38b7ff,#6574ff)}.party-switch>view{width:48rpx;height:48rpx;border-radius:50%;background:white;box-shadow:0 5rpx 10rpx #6574ff12;transition:transform .18s}.party-switch.on>view{transform:translateX(44rpx)}.party-exit-mask{position:fixed;inset:0;z-index:1200;background:#0000008a;display:flex;align-items:center;justify-content:center}.party-exit-card{width:654rpx;background:white;border-radius:52rpx;padding:56rpx 48rpx 48rpx}.party-exit-title{display:block;text-align:center;font-size:46rpx;font-weight:800}.party-exit-description{display:block;text-align:center;color:#7580a0;font-size:28rpx;margin:28rpx 0 50rpx}.party-exit-card button{width:100%}.party-exit-card .source-secondary{margin-top:22rpx}

.party-settings-sheet button,.party-exit-card button{min-width:0}
