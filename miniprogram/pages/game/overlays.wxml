<template name="party-settings">
  <view wx:if="{{settingsOpen}}" class="party-sheet-mask" bindtap="closeSettings"><view class="party-settings-sheet" catchtap="keepOpen"><view class="party-sheet-handle"></view><text class="party-sheet-title">聚会设置</text><text class="party-sheet-subtitle">按喜欢的方式一起玩</text><view class="party-setting-option" data-key="sound" bindtap="toggleSetting"><view class="party-setting-icon"><image src="/assets/original/party/volume_up_rounded.png"/></view><view class="party-setting-copy"><text>音效</text><text>播放游戏提示音</text></view><view class="party-switch {{settings.sound ? 'on' : ''}}"><view/></view></view><view class="party-setting-option" data-key="vibration" bindtap="toggleSetting"><view class="party-setting-icon"><image src="/assets/original/party/vibration_rounded.png"/></view><view class="party-setting-copy"><text>震动</text><text>关键时刻轻轻提醒</text></view><view class="party-switch {{settings.vibration ? 'on' : ''}}"><view/></view></view></view></view>
</template>
<template name="party-exit">
  <view wx:if="{{exitOpen}}" class="party-exit-mask" bindtap="continueGame"><view class="party-exit-card" catchtap="keepOpen"><text class="party-exit-title">结束本局？</text><text class="party-exit-description">{{origin ? '本局取消，返回上一游戏。' : '本局取消，返回聚会。'}}</text><button class="result-primary" bindtap="continueGame">继续玩</button><button class="source-secondary" bindtap="confirmExit">结束并返回</button></view></view>
</template>
