<view class="original-screen"><image class="main-bg" src="/assets/original/main_bg.jpg" mode="aspectFill"/><view class="original-body full-column"><original-nav title="{{pageTitle}}"/><scroll-view class="editor-scroll" scroll-y scroll-top="{{scrollTop}}" bindscroll="recordScroll"><view class="editor-content"><view class="editor-panel"><text class="label">标题</text><input class="field title-field" value="{{title}}" maxlength="-1" placeholder="例如：今天吃什么" placeholder-class="field-placeholder" bindinput="inputTitle"/></view><view class="editor-panel options-panel"><view class="row"><text class="label">选项（{{items.length}}）</text><button class="add-option {{canAdd ? '' : 'add-faint'}}" bindtap="add"><image src="{{canAdd ? '/assets/original/add_rounded.png' : '/assets/original/add_disabled.png'}}"/><text>添加</text></button></view><view class="option-rows"><view wx:for="{{items}}" wx:key="id" class="option-row"><input class="field option-field" value="{{item.text}}" maxlength="-1" placeholder="选项 {{index + 1}}" placeholder-class="field-placeholder" data-index="{{index}}" data-field="text" bindinput="inputItem"/><button class="tap-icon option-icon" data-index="{{index}}" bindtap="toggleItem" aria-label="{{item.excluded ? '已排除' : '参与抽取'}}"><image src="{{item.excluded ? '/assets/original/visibility_off_outlined.png' : '/assets/original/visibility_outlined.png'}}"/></button><button class="tap-icon option-icon {{items.length <= 2 ? 'disabled' : ''}}" data-index="{{index}}" bindtap="remove" aria-label="删除选项"><image src="/assets/original/remove_circle_outline_rounded.png"/></button></view></view></view></view></scroll-view><view class="save-footer"><button class="primary" bindtap="save" loading="{{saving}}" disabled="{{saving}}">保存</button></view></view></view>
