.editor-scroll{flex:1;min-height:0}.editor-content{padding:36rpx 40rpx 24rpx}.editor-panel{padding:32rpx;background:#ffffffb3;border:2.2rpx solid #ffffffeb;border-radius:40rpx;box-shadow:0 20rpx 48rpx #6574ff14,0 -4rpx 16rpx #ffffff52}.title-field{margin-top:16rpx}.options-panel{margin-top:28rpx}.add-option{display:flex;align-items:center;gap:8rpx;padding:12rpx 20rpx;background:#6574ff1f;border:2rpx solid #6574ff4d;color:#6574ff;font-size:28rpx;font-weight:700;border-radius:28rpx}.add-option image{width:36rpx;height:36rpx}.option-rows{margin-top:24rpx}.option-row{display:flex;align-items:center;margin-bottom:20rpx}.option-field{flex:1;min-width:0;width:0}.option-icon{width:96rpx;height:96rpx;flex-shrink:0}.disabled{opacity:.28}.save-footer{padding:16rpx 40rpx calc(32rpx + env(safe-area-inset-bottom));flex-shrink:0}
.add-faint{color:#c3cae0}

/* Native v2 buttons have intrinsic widths; keep Flutter Expanded input + 48px actions. */
.title-field{display:block;width:100%;min-width:0;max-width:100%}.option-row .option-field{display:block;flex:1 1 0%;width:0;min-width:0;max-width:100%}.option-row .option-icon{flex:0 0 96rpx;width:96rpx;min-width:96rpx;max-width:96rpx;padding:0;margin:0}.options-panel .add-option{flex:0 0 144rpx;width:144rpx;min-width:144rpx;max-width:144rpx;justify-content:center;white-space:nowrap;margin:0}.save-footer .primary{width:100%;min-width:0;max-width:100%}
