<view class="original-screen"><image class="main-bg" src="/assets/original/main_bg.jpg" mode="aspectFill"/><view class="original-body full-column"><original-nav title="数字工具"/><view class="number-body"><view class="mode-toggle"><view class="mode-cell {{mode === 'random' ? 'selected' : ''}}" data-mode="random" bindtap="mode"><image wx:if="{{mode === 'random'}}" src="/assets/original/number_tab_selected.png" mode="scaleToFill"/><text>范围随机</text></view><view class="mode-cell {{mode === 'counter' ? 'selected' : ''}}" data-mode="counter" bindtap="mode"><image wx:if="{{mode === 'counter'}}" src="/assets/original/number_tab_selected.png" mode="scaleToFill"/><text>计数器</text></view></view><view wx:if="{{mode === 'random'}}" class="range-mode"><view class="number-settings"><view class="number-fields"><view wx:for="{{['min','max','count']}}" wx:key="*this" class="number-field"><text>{{index === 0 ? '最小值' : index === 1 ? '最大值' : '数量'}}</text><input class="field number-input" type="number" maxlength="{{index === 2 ? 3 : 6}}" value="{{index === 0 ? min : index === 1 ? max : count}}" data-field="{{item}}" bindinput="input" focus="{{focusField === item}}" bindfocus="focus" bindblur="blur" bindkeyboardheightchange="keyboard" confirm-type="{{index === 2 ? 'done' : 'next'}}" bindconfirm="confirm" adjust-position="{{false}}"/></view></view><view class="range-options"><button class="range-reset" bindtap="resetRange"><image src="/assets/original/reset_icon.png"/>重置</button><view class="repeat-control"><text>不重复</text><switch color="#6574FF" checked="{{!repeat}}" bindchange="repeat"/></view></view></view><view class="number-results"><view wx:if="{{!results.length}}" class="empty-hint"><image src="/assets/original/casino_rounded.png"/><text>点击下方按钮抽取</text></view><scroll-view wx:else class="results-scroll" scroll-y><view class="results-wrap"><view wx:for="{{displayResults}}" wx:key="id" class="number-result {{item.settled ? 'number-settled' : ''}}" style="width:{{item.width}}rpx">{{item.value}}</view></view></scroll-view></view><view class="number-cta"><art-button label="随机抽取" bind:action="roll"/></view></view><view wx:else class="counter-mode"><view class="counter-card"><view wx:for="{{counterFrame}}" wx:key="id" class="counter-value {{item.transition}}"><text class="old-value">{{item.old}}</text><text class="new-value">{{item.value}}</text></view></view><view class="counter-buttons"><button class="counter-step" data-step="-1" bindtap="step"><image src="/assets/original/remove_rounded.png"/></button><button class="counter-step" data-step="1" bindtap="step"><image src="/assets/original/add_counter.png"/></button></view><button class="counter-reset" bindtap="reset">清零</button></view></view><view class="bottom-safe"></view></view><view wx:if="{{keyboardHeight > 0 && focusField}}" class="keyboard-toolbar" style="bottom:{{keyboardHeight + 8}}px"><button class="keyboard-arrow {{focusField === 'min' ? 'disabled' : ''}}" bindtap="previous"><image src="/assets/original/keyboard_arrow_up_rounded.png"/></button><button class="keyboard-arrow {{focusField === 'count' ? 'disabled' : ''}}" bindtap="next"><image src="/assets/original/keyboard_arrow_down_rounded.png"/></button><button class="keyboard-done" bindtap="commit">完成</button></view></view>
