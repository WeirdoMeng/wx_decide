.welcome{padding:54rpx 40rpx 64rpx;text-align:center}.logo{width:112rpx;height:112rpx;margin-bottom:28rpx}.title{font-size:42rpx}.subtitle{margin-top:16rpx}.login-card{display:block;width:100%;box-sizing:border-box;margin-top:36rpx;text-align:center;padding:36rpx}.profile-form{display:block;width:100%;box-sizing:border-box}.description{font-size:25rpx;color:#7580a0;line-height:1.7;margin:16rpx 0 32rpx}.avatar-picker.avatar-picker{position:relative;display:flex;align-items:center;justify-content:center;width:132rpx;min-width:132rpx;max-width:132rpx;height:132rpx;min-height:132rpx;max-height:132rpx;flex:none;box-sizing:border-box;border-radius:50%;padding:0;margin:0 auto;background:#f0f3ff;border:4rpx solid #fff;box-shadow:0 12rpx 30rpx #6574ff1c;overflow:visible}.chosen-avatar{width:124rpx;height:124rpx;border-radius:50%}.default-avatar{width:72rpx;height:72rpx}.avatar-add{position:absolute;right:-2rpx;bottom:0;width:38rpx;height:38rpx;display:flex;align-items:center;justify-content:center;border-radius:50%;background:#6574ff;color:white;font-size:30rpx;border:3rpx solid white;line-height:1}.avatar-caption{font-size:23rpx;color:#7580a0;margin:18rpx 0 28rpx}.nickname-field{display:flex;align-items:center;gap:24rpx;background:#fff9;border:2rpx solid white;border-radius:24rpx;padding:24rpx;margin-bottom:32rpx;text-align:left;min-height:96rpx}.field-label{font-size:26rpx;color:#7580a0;flex-shrink:0}.nickname-field input{flex:1;min-width:0;height:48rpx;line-height:48rpx;font-size:29rpx;color:#121a38}.nickname-placeholder{color:#a7afc6;font-size:27rpx}.hint{font-size:22rpx;line-height:1.7;text-align:center;color:#9ca6c2;margin-top:24rpx}

.login-submit.login-submit{display:flex;align-items:center;justify-content:center;width:100%;min-width:0;max-width:100%;height:104rpx;min-height:104rpx;margin:0;padding:20rpx 24rpx;box-sizing:border-box}.avatar-picker::after,.login-submit::after{border:0}
