<import src="../game/overlays.wxml"/>
<view class="source-hub" ><image class="source-hub-background" src="/assets/original/main_bg.jpg" mode="aspectFill"/>
 <original-nav title="聚会玩一局" brand="{{true}}" back="{{false}}" help="{{true}}" help-label="聚会设置" help-icon="/assets/original/party/tune_rounded.png" bind:help="showSettings"/>
 <view class="billiards-banner" bindtap="chooseBilliards" aria-label="选择3D黑8或3D斯诺克"><image class="banner-background" src="/assets/original/party/party_banner_empty.png" mode="scaleToFill"/><image wx:if="{{entranceSeen && !entrance}}" class="banner-ball" src="/assets/original/party/party_eight_ball.png" mode="aspectFit"/><view class="banner-start"><image src="/assets/original/party/play_arrow_rounded.png"/><text>开始游戏</text></view></view>
 <view wx:if="{{bannerUnit && !bannerFailed && !settingsOpen && !billiardsOpen && !introShow && !entrance}}" class="party-ad-slot"><ad unit-id="{{bannerUnit}}" data-unit="{{bannerUnit}}" bindload="adLoad" binderror="adError" bindclose="adClose"/></view>
 <text class="games-section-title">聚会小游戏</text>
 <view class="original-game-grid"><button wx:for="{{games}}" wx:key="key" class="original-entry-card" data-key="{{item.key}}" bindtap="play" aria-label="{{item.title}}"><view wx:if="{{item.key === 'dice'}}" class="dice-entry"><image src="{{item.cover}}" mode="aspectFit"/><view class="dice-entry-title">摇骰子</view><view class="dice-entry-description">摇一摇，开盅见点数</view><view class="dice-entry-arrow">›</view></view><view wx:elif="{{item.custom}}" class="new-entry {{item.key}}"><view class="new-entry-art"><text>{{item.symbol}}</text><view class="new-entry-spark">✦</view></view><view class="dice-entry-title">{{item.title}}</view><view class="dice-entry-description">{{item.subtitle}}</view><view class="dice-entry-arrow">›</view></view><image wx:else src="{{item.cover}}" mode="aspectFill"/></button></view>
</view>
<view wx:if="{{billiardsOpen}}" class="billiards-sheet-mask" bindtap="closeBilliards"><view class="billiards-sheet" catchtap="keepOpen"><view class="billiards-handle"></view><text class="billiards-sheet-title">选择台球玩法</text><text class="billiards-subtitle">一部手机，和朋友轮流来一杆</text><view class="billiards-choices"><button wx:for="{{billiards}}" wx:key="key" data-key="{{item.key}}" bindtap="play" aria-label="{{item.title}}"><image src="{{item.cover}}" mode="aspectFill"/></button></view></view></view>
<template is="party-settings" data="{{settingsOpen,settings}}"/>
<result-dialog show="{{introShow}}" result="{{introTitle}}" title="" description="{{introDescription}}" icon="{{introIcon}}" again-label="我知道了，开始玩" done-label="" bind:again="confirmIntro" bind:close="closeIntro"/>
<view wx:if="{{entrance}}" class="party-entrance" bindtap="skipEntrance"><view class="entrance-glow" style="left:{{ball.left - ball.size*.22}}rpx;top:{{ball.top-ball.size*.22}}rpx;width:{{ball.size*1.44}}rpx;height:{{ball.size*1.44}}rpx;"></view><image class="entrance-ball" src="/assets/original/party/{{sprite}}" mode="aspectFit" style="left:{{ball.left}}rpx;top:{{ball.top}}rpx;width:{{ball.size}}rpx;height:{{ball.size}}rpx;transform:rotate({{ball.angle}}deg);"/><image class="entrance-ball" src="/assets/original/party/{{nextSprite}}" mode="aspectFit" style="left:{{ball.left}}rpx;top:{{ball.top}}rpx;width:{{ball.size}}rpx;height:{{ball.size}}rpx;transform:rotate({{ball.angle}}deg);opacity:{{blend}};"/><view class="entrance-cue" style="left:{{cue.left}}rpx;top:{{cue.top}}rpx;opacity:{{cue.opacity}};"></view><text class="entrance-skip" style="top:{{safeTop+10}}px;">点击跳过　›</text></view>
