@import '../game/overlays.wxss';
page{background:#f4f8ff}.source-hub{min-height:100vh;padding-bottom:calc(184rpx + env(safe-area-inset-bottom));position:relative}.source-hub button{padding:0;margin:0;border:0;line-height:1;background:transparent}.source-hub button::after,.billiards-sheet button::after{border:0}.source-hub-header{height:136rpx;padding:24rpx 32rpx 16rpx 40rpx;display:flex;align-items:center;gap:20rpx}.home-logo-frame{width:96rpx;height:96rpx;padding:10rpx;border-radius:32rpx;border:2rpx solid #ffffffe6;background:#ffffffbd;box-shadow:0 8rpx 20rpx #6574ff0b}.home-logo-frame image{width:100%;height:100%;border-radius:24rpx}.source-hub-header>text{font-size:44rpx;color:#121a38;font-weight:800;letter-spacing:.4rpx}.source-hub .settings-button{margin-left:auto;width:90rpx;height:90rpx;border-radius:30rpx;background:#ffffffc7;border:2rpx solid white;display:flex;align-items:center;justify-content:center}.settings-button image{width:50rpx;height:50rpx}.billiards-banner{position:relative;margin:4rpx 32rpx 40rpx;height:calc((100vw - 64rpx)*534/1041)}.banner-background{width:100%;height:100%}.banner-ball{position:absolute;left:55.6%;top:19.4%;width:36%;height:70.2%}.banner-start{position:absolute;left:32rpx;bottom:36rpx;width:236rpx;height:68rpx;border-radius:48rpx;background:linear-gradient(90deg,#44b9f7,#bd55ed);box-shadow:0 10rpx 24rpx #8e65ed57;display:flex;align-items:center;justify-content:center;gap:10rpx;color:white;font-size:28rpx;font-weight:800}.banner-start image{width:44rpx;height:44rpx}.games-section-title{display:block;font-size:38rpx;font-weight:900;letter-spacing:.4rpx;margin:0 32rpx 20rpx;color:#121a38}.original-game-grid{margin:0 32rpx 48rpx;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20rpx}.original-game-grid .original-entry-card{width:100%;min-width:0;max-width:100%;display:block;border-radius:40rpx;overflow:hidden;height:calc((100vw - 84rpx)/2*354/504)}.original-entry-card image{width:100%;height:100%;display:block}.billiards-sheet-mask{position:fixed;inset:0;z-index:1200;background:#00000080;display:flex;align-items:flex-end}.billiards-sheet{width:100%;padding:24rpx 40rpx calc(44rpx + env(safe-area-inset-bottom));border-radius:56rpx 56rpx 0 0;background:#f8faff}.billiards-handle{width:76rpx;height:8rpx;border-radius:8rpx;background:#d6dbe8;margin:0 auto 32rpx}.billiards-sheet-title{font-size:40rpx;font-weight:900;text-align:center;display:block;color:#121a38}.billiards-subtitle{font-size:26rpx;color:#7580a0;text-align:center;display:block;margin-top:10rpx}.billiards-choices{display:flex;gap:24rpx;margin-top:36rpx}.billiards-choices button{width:0;min-width:0;flex:1;border-radius:40rpx;background:white;padding:0;overflow:hidden;box-shadow:0 8rpx 20rpx #6574ff0b}.billiards-choices image{width:100%;height:calc((100vw - 104rpx)/2);display:block}.party-entrance{position:fixed;inset:0;z-index:1400;overflow:hidden}.entrance-ball{position:absolute}.entrance-glow{position:absolute;border-radius:50%;background:radial-gradient(ellipse,#50c8ff56,#9f68ff26,transparent 70%)}.entrance-skip{position:absolute;right:32rpx;padding:14rpx 24rpx;border-radius:40rpx;background:#ffffffd6;border:2rpx solid white;color:#6652b6;font-size:22rpx;font-weight:700}.entrance-cue{position:absolute;width:460rpx;height:36rpx;transform-origin:left center;transform:rotate(24.06deg);background:linear-gradient(90deg,#e5ffff,#8fd9ff 12%,#8f62ea 72%,#423a91);clip-path:polygon(0 39%,100% 0,100% 100%,0 61%);filter:drop-shadow(0 3rpx 9rpx #6b67ff)}

/* WeChat v2 buttons have a built-in minimum width; original Flutter controls do not. */
button{min-width:0}

.source-hub-background{position:fixed;top:0;left:0;width:100vw;height:100vh;z-index:0;pointer-events:none}.source-hub-header,.billiards-banner,.games-section-title,.original-game-grid{position:relative;z-index:1}

.party-ad-slot{position:relative;z-index:1;margin:0 32rpx 40rpx;min-width:0}

/* 摇骰子入口与原有六张插画卡片同列，素材来自 shaizi 经典骰子。 */
.dice-entry{position:relative;width:100%;height:100%;background:linear-gradient(125deg,#eee6ff,#dce7ff);border:2rpx solid #ffffff9c;border-radius:40rpx;overflow:hidden}.dice-entry image{position:absolute;left:112rpx;top:6rpx;width:124rpx;height:124rpx}.dice-entry-title{position:absolute;left:22rpx;bottom:57rpx;font-size:32rpx;font-weight:800;color:#121a38;line-height:1.3}.dice-entry-description{position:absolute;left:22rpx;bottom:22rpx;font-size:22rpx;line-height:1.2;color:#8390a7}.dice-entry-arrow{position:absolute;right:22rpx;bottom:35rpx;width:58rpx;height:58rpx;line-height:49rpx;text-align:center;background:#ffffffc7;border:2rpx solid white;border-radius:50%;font-size:57rpx;color:#121a38}

.new-entry{position:relative;width:100%;height:100%;border:2rpx solid #ffffff9c;border-radius:40rpx;overflow:hidden;background:linear-gradient(125deg,#e7e3ff,#f8e7f8)}.new-entry.tenSeconds{background:linear-gradient(125deg,#e3edff,#dceff8)}.new-entry.charades{background:linear-gradient(125deg,#fff0d8,#f5e4ef)}.new-entry-art{position:absolute;left:120rpx;top:18rpx;width:100rpx;height:92rpx;border-radius:26rpx;transform:rotate(-10deg);background:linear-gradient(145deg,#f9fbff,#cdc5ff);border:4rpx solid #f9fbff;box-shadow:0 10rpx 18rpx #6574ff2a;display:flex;align-items:center;justify-content:center;color:#8274e9;font-size:54rpx;font-weight:800}.tenSeconds .new-entry-art{border-radius:50%;background:linear-gradient(145deg,#f9fbff,#b8deff);color:#5798e6;transform:rotate(10deg)}.charades .new-entry-art{background:linear-gradient(145deg,#fff9ed,#ffcbdc);color:#d880a8}.new-entry-spark{position:absolute;right:-26rpx;top:-8rpx;font-size:38rpx;color:#fcfdff;font-weight:400}
