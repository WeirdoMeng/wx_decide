.coin-status{margin:20rpx 48rpx 0;height:92rpx;display:flex;align-items:center;justify-content:center;background:#fffffff5;border:2rpx solid white;border-radius:32rpx;box-shadow:0 12rpx 36rpx #6e7bdf29;flex-shrink:0;font-size:28rpx;font-weight:500;color:#7580a0}.settled{font-size:34rpx;font-weight:800;color:#6574ff}.coin-stage{flex:1;position:relative;display:flex;align-items:center;justify-content:center;min-height:240rpx}.coin-lift{width:400rpx;height:400rpx;position:relative;transform-origin:center}.coin-model{width:400rpx;height:400rpx;position:relative;transform-style:flat}.coin-metal-layer{position:absolute;left:9rpx;top:9rpx;width:382rpx;height:382rpx;border-radius:50%;transform-origin:center}.coin-face{position:absolute;inset:0;transform-origin:center}.coin-face image{width:100%;height:100%}.coin-edge-highlight{position:absolute;left:11.865rpx;top:11.865rpx;width:376.27rpx;height:376.27rpx;border-radius:50%;border:3.2rpx solid;transform-origin:center}.coin-preload{position:absolute;left:0;top:0;width:1rpx;height:1rpx;opacity:0;pointer-events:none}.coin-ground{position:absolute;top:calc(75% - 11rpx);height:44rpx;border-radius:50%;background:radial-gradient(ellipse,#7651f53d,transparent 70%)}.stats{margin:0 48rpx;display:flex;align-items:center;justify-content:center;gap:24rpx;flex-shrink:0}.stat-chip{padding:12rpx 28rpx;background:#ffffffef;border:2rpx solid #ffffffb3;border-radius:40rpx;color:#7580a0;font-size:26rpx;font-weight:600}.heads{color:#6574ff}.reset-stats{width:56rpx;height:56rpx;border-radius:50%;background:#ffffffef;border:2rpx solid #ffffffb3;display:flex;align-items:center;justify-content:center;padding:0}.reset-stats image{width:32rpx;height:32rpx}.empty-stats{height:16rpx;flex-shrink:0}.skin-scroll{height:220rpx;width:calc(100% - 48rpx);margin:24rpx 24rpx 0;flex-shrink:0;border:2rpx solid #ffffffe0;border-radius:48rpx;background:#ffffff9e;box-shadow:0 8rpx 20rpx #3e66b118;overflow:hidden;white-space:nowrap}.skin-row{height:100%;display:inline-flex;align-items:center;gap:28rpx;padding:10rpx 24rpx}.skin{display:flex;flex-direction:column;align-items:center;justify-content:center;width:120rpx;flex-shrink:0;font-size:22rpx;font-weight:400;color:#9ca6c2;gap:12rpx;transition:width .2s}.skin-ring{display:flex;align-items:center;justify-content:center;width:120rpx;height:120rpx;border:4rpx solid transparent;border-radius:50%;background:#ffffffef;transition:all .2s}.skin-face{width:104rpx;height:104rpx;border-radius:50%;overflow:hidden;transition:all .2s}.skin-face image{width:100%;height:100%}.selected{width:148rpx;color:#6574ff;font-weight:600}.selected .skin-ring{width:148rpx;height:148rpx;border-color:#6574ff;box-shadow:0 0 28rpx #6574ff4d}.selected .skin-face{width:132rpx;height:132rpx}.coin-cta{margin-top:24rpx;height:174rpx;display:flex;align-items:flex-start;justify-content:center;flex-shrink:0}.bottom-safe{height:env(safe-area-inset-bottom);flex-shrink:0}
/* Keep source control sizes above native v2 button minimums. */
.stats .reset-stats{flex:0 0 56rpx;min-width:56rpx;max-width:56rpx}
