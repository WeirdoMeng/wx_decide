<view class="original-screen"><image class="main-bg" src="/assets/original/main_bg.jpg" mode="aspectFill"/><view class="original-body full-column"><original-nav title="抛硬币"/><view class="coin-status {{result && !flipping ? 'settled' : ''}}">{{flipping ? '抛掷中...' : result ? '结果：' + (result === '正面' ? '正' : '反') : '点击硬币 / 左右滑动换皮肤'}}</view><view class="coin-stage" bindtap="stageTap" bindtouchstart="stageStart" bindtouchend="stageEnd"><view class="coin-ground" style="width:{{coin.shadowWidth}}rpx;opacity:{{coin.shadowOpacity}}"></view><view class="coin-lift" style="transform:translateY({{-coin.lift * 120 * heightScale}}px) scale({{coin.liftScale}})"><view class="coin-model"><view wx:for="{{edges}}" wx:key="index" class="coin-metal-layer" style="opacity:{{coin.sideVisibility * (.78 + item.index * .022)}};transform:translateY({{coin.sideAmount * 18.4 * item.index / 8}}rpx) {{coin.edgeMatrix}};background:linear-gradient({{item.top}},{{item.middle}} 43%,{{item.bottom}})"></view><view class="coin-face" style="transform:{{coin.faceMatrix}}"><image src="/assets/original/coin{{skin + 1}}_{{coin.face}}.png" mode="aspectFit"/></view><view wx:if="{{coin.sideVisibility > .08}}" class="coin-edge-highlight" style="opacity:{{coin.sideVisibility * .72}};border-color:{{edgeHighlight}}e6;transform:translateY({{coin.sideAmount * 16.56}}rpx) {{coin.edgeMatrix}}"></view></view></view><image class="coin-preload" src="/assets/original/coin{{skin + 1}}_heads.png"/><image class="coin-preload" src="/assets/original/coin{{skin + 1}}_tails.png"/></view><view class="stats" wx:if="{{total}}"><view class="stat-chip heads">正 {{heads}}</view><view class="stat-chip">反 {{tails}}</view><button class="reset-stats" bindtap="reset" aria-label="清空统计"><image src="/assets/original/refresh_rounded.png"/></button></view><view class="empty-stats" wx:else></view><scroll-view class="skin-scroll" scroll-x scroll-left="{{scrollLeft}}" scroll-with-animation enhanced show-scrollbar="{{false}}"><view class="skin-row"><view wx:for="{{skins}}" wx:key="index" class="skin {{skin === item.index ? 'selected' : ''}}" data-index="{{item.index}}" bindtap="choose"><view class="skin-ring"><view class="skin-face"><image src="{{item.image}}" mode="aspectFit"/></view></view><text>{{item.name}}</text></view></view></scroll-view><view class="coin-cta"><art-button label="{{flipping ? '抛掷中…' : '抛硬币'}}" disabled="{{flipping}}" bind:action="flip"/></view><view class="bottom-safe"></view></view></view>
