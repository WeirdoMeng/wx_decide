.home-shell{padding:24rpx 32rpx 16rpx 40rpx;height:136rpx;display:flex;align-items:center;gap:20rpx;flex-shrink:0}.home-shell>text{font-size:44rpx;font-weight:800;letter-spacing:.4rpx}.home-logo{width:96rpx;height:96rpx;padding:10rpx;background:#ffffffbd;border-radius:32rpx;border:2rpx solid white;box-shadow:0 8rpx 20rpx #3e66b118}.home-logo image{width:100%;height:100%;border-radius:24rpx}.wheel-top{padding:20rpx 24rpx 20rpx 40rpx;display:flex;align-items:center;gap:20rpx;flex-shrink:0}.list-card{flex:1;width:0;min-width:0;display:flex;align-items:center;padding:24rpx 28rpx;border-radius:36rpx;background:#ffffffc7;border:2rpx solid #ffffffb3;box-shadow:0 8rpx 20rpx #3e66b118}.blind-box{width:88rpx;height:88rpx;margin-right:24rpx;flex-shrink:0}.list-copy{display:flex;flex-direction:column;flex:1;min-width:0}.list-title{font-size:34rpx;font-weight:800;color:#121a38;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}.list-count{font-size:24rpx;color:#9ca6c2;font-weight:500;margin-top:4rpx}.expand{width:44rpx;height:44rpx;margin-left:8rpx}.tune{flex:0 0 92rpx;min-width:0;max-width:92rpx;width:92rpx;height:92rpx;padding:0;display:flex;align-items:center;justify-content:center;border-radius:32rpx;background:#ffffffc7;border:2rpx solid #ffffffb3}.tune image{width:44rpx;height:44rpx}.wheel-area{flex:1;display:flex;align-items:center;justify-content:center;min-height:0}.wheel-wrap{position:relative;width:688rpx;height:688rpx;border-radius:50%;box-shadow:0 28rpx 68rpx #5a78bb3b,0 0 120rpx -24rpx #42dcd647}.wheel{position:absolute;top:-20.64rpx;left:0;width:688rpx;height:708.64rpx}.wheel-center{position:absolute;left:266.5rpx;top:266.5rpx;width:155rpx;height:155rpx;pointer-events:none;animation:breathe 3.6s ease-in-out infinite}.wheel-pointer{position:absolute;top:-20.6rpx;left:291rpx;width:106rpx;height:106rpx;pointer-events:none}.wheel-cta{height:174rpx;flex-shrink:0;display:flex;align-items:flex-start;justify-content:center}.tab-reserve{height:calc(184rpx + env(safe-area-inset-bottom));flex-shrink:0}.minimum-hint{color:#9ca6c2;font-size:24rpx;text-align:center;margin-bottom:32rpx}@keyframes breathe{0%,100%{transform:scale(.985)}50%{transform:scale(1.035)}}
.wheel-snapshot{position:absolute;top:-20.64rpx;left:0;width:688rpx;height:708.64rpx}

.home-ad-slot{flex-shrink:0;min-width:0;margin:16rpx 32rpx 12rpx}.home-has-ad{height:auto;min-height:100vh}.home-has-ad .wheel-area{flex:1 0 752rpx}
