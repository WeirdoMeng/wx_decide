<view class="original-screen"><image class="main-bg" src="/assets/original/main_bg.jpg" mode="aspectFill"/><view class="original-body full-column home-content"><original-nav title="小决定" back="{{false}}" brand="{{true}}"/><view wx:if="{{bannerUnit && !bannerFailed && !listsOpen && !resultOpen}}" class="home-ad-slot"><ad unit-id="{{bannerUnit}}" data-unit="{{bannerUnit}}" bindload="adLoad" binderror="adError" bindclose="adClose"/></view><view class="wheel-top"><view class="list-card" bindtap="openLists"><image class="blind-box" src="/assets/original/blind_box_icon.png" mode="aspectFit"/><view class="list-copy"><text class="list-title">{{title}}</text><text class="list-count">{{count}} 个有效选项</text></view><image class="expand" src="/assets/original/expand_more_rounded.png"/></view><button class="tune" bindtap="edit" disabled="{{spinning}}" aria-label="编辑当前列表"><image src="/assets/original/tune_rounded.png"/></button></view><view class="wheel-area"><view class="wheel-wrap" bindtap="spin"><canvas id="wheel" type="2d" class="wheel" hidden="{{listsOpen || resultOpen}}"></canvas><image wx:if="{{(listsOpen || resultOpen) && wheelSnapshot}}" class="wheel-snapshot" src="{{wheelSnapshot}}" mode="scaleToFill"/></view></view><view class="wheel-cta"><art-button label="{{spinning ? '转动中…' : '开始转动'}}" disabled="{{spinning || count < 2 || !ready}}" bind:action="spin"/></view><text wx:if="{{count < 2}}" class="minimum-hint">至少需要 2 个有效选项</text><view class="tab-reserve"></view></view><list-sheet show="{{listsOpen}}" current-id="{{selected ? selected.id : ''}}" bind:close="closeLists" bind:selectlist="selectList" bind:change="listsChanged"/><result-dialog show="{{resultOpen}}" result="{{result}}" bind:close="closeResult" bind:again="again"/></view>
