.dice-screen{min-height:100vh}.dice-content{padding:16rpx 36rpx calc(40rpx + env(safe-area-inset-bottom))}.dice-heading{text-align:center;font-size:42rpx;font-weight:800;margin-top:12rpx}.dice-description{text-align:center;font-size:24rpx;color:#8390ae;margin:16rpx 0 30rpx}.dice-config{padding:24rpx 28rpx}.config-label{font-size:25rpx;font-weight:650;display:flex;justify-content:space-between;align-items:center}.config-label text{color:#8c83d1;font-size:23rpx}.count-options{display:flex;gap:14rpx;margin-top:20rpx}.count-option.count-option{flex:1;width:0;min-width:0;padding:0;height:66rpx;line-height:66rpx;border-radius:22rpx;background:#eef1fb;color:#8993ac;font-size:29rpx;font-weight:700;border:2rpx solid transparent}.count-option.selected{background:linear-gradient(135deg,#6eb8ff,#9271f8);color:#fff;border-color:#ffffffbc;box-shadow:0 8rpx 18rpx #8270ec26}.dice-stage{position:relative;height:700rpx;margin:8rpx -20rpx 0}.dice-scene{display:block;width:100%;height:660rpx}.stage-hint{position:absolute;bottom:4rpx;left:0;right:0;text-align:center;color:#8c8bb2;font-size:24rpx;letter-spacing:1rpx;pointer-events:none}.scene-loading{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:28rpx;color:#8993ad;font-size:26rpx}.scene-loading button{font-size:26rpx;padding:16rpx 32rpx;min-height:78rpx}
.sum-card{margin:10rpx 12rpx 26rpx;padding:22rpx 26rpx;text-align:center}.total{font-size:24rpx;color:#7a86a6}.total text{font-size:46rpx;font-weight:800;color:#7e73ed;padding:0 8rpx}.point-counts{display:flex;flex-wrap:wrap;justify-content:center;gap:10rpx 24rpx;color:#9299b2;font-size:21rpx;margin-top:12rpx}.dice-actions{display:flex;align-items:center;gap:24rpx;margin-top:30rpx}.open-action.open-action{width:180rpx;max-width:180rpx;min-width:0;height:110rpx;min-height:110rpx;padding:0;flex:none;font-size:30rpx}.shake-action{flex:1;min-width:0}.motion-switch.motion-switch{min-width:0;padding:18rpx;background:transparent;color:#8a86b7;font-size:23rpx;margin:18rpx auto 0;line-height:1.6}.motion-switch text{font-size:21rpx;color:#a5adc1;padding-left:18rpx}.sensor-note{text-align:center;font-size:23rpx;color:#9ca6bf;margin-top:28rpx}